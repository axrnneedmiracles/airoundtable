# ElevenLabs API Key (Required for high-fidelity voice generation)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# (Optional) Whisper Server URL (defaults to local whisper.cpp server)
WHISPER_SERVER_URL=http://127.0.0.1:8080/inference

# (Optional) Local Ollama Endpoint
OLLAMA_HOST=http://127.0.0.1:11434
